<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Notebook</display-name>

    <!-- SAS framework context listener -->
    <listener>
        <listener-class>com.zoho.sas.container.SASContextListener</listener-class>
    </listener>

    <!-- =====================================================================
         Access Log Filter
    ===================================================================== -->
    <filter>
        <filter-name>AccessLogFilter</filter-name>
        <filter-class>com.zoho.logs.logclient.filter.AccessLogFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AccessLogFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <!-- =====================================================================
         IAM Security Filter
         Uses CustomAuthenticationProvider for unauthenticated redirect logic.
    ===================================================================== -->
    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>com.adventnet.iam.security.SecurityFilter</filter-class>
        <init-param>
            <param-name>config-file</param-name>
            <param-value>conf/security-common.xml,conf/security-safeheaders.xml,conf/security-useragent.xml,conf/security-properties.xml,conf/security-path.xml</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- =====================================================================
         ThreadLocal Filter
         Only runs on authenticated endpoints — public pages don't need it.
    ===================================================================== -->
    <filter>
        <filter-name>ThreadLocalFilter</filter-name>
        <filter-class>com.zoho.notebook.filter.ThreadLocalFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ThreadLocalFilter</filter-name>
        <url-pattern>/user/profile</url-pattern>
        <url-pattern>/user/contacts</url-pattern>
        <url-pattern>/user/logout</url-pattern>
        <url-pattern>/notebooks/*</url-pattern>
    </filter-mapping>

    <!-- =====================================================================
         JSP Servlet (for login.jsp)
    ===================================================================== -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>jsp</servlet-name>
        <url-pattern>/login.jsp</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         Logout — IAM clears the IAMAGENTTICKET cookie
    ===================================================================== -->
    <servlet>
        <servlet-name>UserLogoutServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserLogoutServlet</servlet-name>
        <url-pattern>/user/logout</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         Profile
    ===================================================================== -->
    <servlet>
        <servlet-name>UserProfileServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserProfileServlet</servlet-name>
        <url-pattern>/user/profile</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         User Contacts (emails / phones — managed via IAM APIs)
    ===================================================================== -->
    <servlet>
        <servlet-name>UserContactServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserContactServlet</servlet-name>
        <url-pattern>/user/contacts</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         Notes (forwarded from NotebookServlet when URI contains /notes)
    ===================================================================== -->
    <servlet>
        <servlet-name>NoteServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.NoteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NoteServlet</servlet-name>
        <url-pattern>/notebooks/*/notes</url-pattern>
        <url-pattern>/notebooks/*/notes/*</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         Notebooks
    ===================================================================== -->
    <servlet>
        <servlet-name>NotebookServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.NotebookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotebookServlet</servlet-name>
        <url-pattern>/notebooks</url-pattern>
        <url-pattern>/notebooks/*</url-pattern>
    </servlet-mapping>

    <!-- =====================================================================
         Welcome page
    ===================================================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>