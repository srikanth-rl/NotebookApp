<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Notebook</display-name>
    
    <filter>
        <filter-name>Instrumentation</filter-name>
        <filter-class>com.zoho.instrument.InstrumentFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>Instrumentation</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <filter>
        <filter-name>AccessLogFilter</filter-name>
        <filter-class>com.zoho.logs.logclient.filter.AccessLogFilter</filter-class>
    </filter>
    
    <filter-mapping>
        <filter-name>AccessLogFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>
    
    <filter>
	    <filter-name>SecurityFilter</filter-name>
	    <filter-class>com.adventnet.iam.security.SecurityFilter</filter-class>
	    <init-param>
		    <param-name>config-file</param-name>
		    <param-value>conf/security-common.xml,conf/security-safeheaders.xml,conf/security-useragent.xml,conf/security-properties.xml,conf/security-path.xml</param-value>
		</init-param>
	    <init-param>
	        <param-name>development.mode</param-name>
	        <param-value>true</param-value>
	    </init-param>
	</filter>

    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.zoho.notebook.filter.AuthenticationFilter</filter-class>
    </filter>
    
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/user/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/notebooks/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>UserSignupServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserSignupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserSignupServlet</servlet-name>
        <url-pattern>/user/signup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserLoginServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserLoginServlet</servlet-name>
        <url-pattern>/user/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserLogoutServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserLogoutServlet</servlet-name>
        <url-pattern>/user/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserProfileServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserProfileServlet</servlet-name>
        <url-pattern>/user/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserContactServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.UserContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserContactServlet</servlet-name>
        <url-pattern>/user/contacts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotebookServlet</servlet-name>
        <servlet-class>com.zoho.notebook.controller.NotebookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotebookServlet</servlet-name>
        <url-pattern>/notebooks/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>