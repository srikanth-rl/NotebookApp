# --- Selective Build Rules ---
# Ignore all subdirectories inside build/ but keep top-level files
build/*/
notebook/build/*/

# Specifically ignore these build artifacts
build/all_unused.jar
build/buildlogs/
build/NoteBook_build_stage/
*.war
*.zip

# --- Project Folders ---
dependencies/
bin/
logs/

# --- Runtime Logs ---
*.log
*.lck

# --- IDE Metadata (Eclipse/VS Code) ---
.project
.classpath
.settings/
.cache/
.history/
*.tmp
*.bak

# --- OS Specific ---
.DS_Store
Thumbs.db
