                <data-type>BIGINT</data-type>
                <nullable>false</nullable>
            </column>
            <column name="title">
                <data-type>CHAR</data-type>
                <max-size>255</max-size>
            </column>
            <column name="content">
                <data-type>CHAR</data-type>
            </column>
            <column name="is_pinned">
                <data-type>BOOLEAN</data-type>
                <default-value>false</default-value>
            </column>
            <column name="created_by">
                <data-type>BIGINT</data-type>
            </column>
            <column name="updated_by">
                <data-type>BIGINT</data-type>
            </column>
            <column name="created_at">
                <data-type>BIGINT</data-type>
            </column>
            <column name="updated_at">
                <data-type>BIGINT</data-type>
            </column>
        </columns>
        <primary-key name="notes_pk">
            <primary-key-column>id</primary-key-column>
        </primary-key>
        <foreign-keys>
            <foreign-key name="fk_note_notebook" reference-table-name="notebooks">
                <fk-columns>
                    <fk-column>
                        <fk-local-column>notebook_id</fk-local-column>
                        <fk-reference-column>id</fk-reference-column>
                    </fk-column>
                </fk-columns>
                <fk-constraints>ON-DELETE-CASCADE</fk-constraints>
            </foreign-key>
            <foreign-key name="fk_note_created_by" reference-table-name="user">
                <fk-columns>
                    <fk-column>
                        <fk-local-column>created_by</fk-local-column>
                        <fk-reference-column>id</fk-reference-column>
                    </fk-column>
                </fk-columns>
                <fk-constraints>ON-DELETE-SET-NULL</fk-constraints>
            </foreign-key>
        </foreign-keys>
    </table>

    <table name="audit_logs">
        <columns>
            <column name="id">
                <data-type>BIGINT</data-type>
                <nullable>false</nullable>
                <uniquevalue-generation>
                    <generator-name>audit_logs.id</generator-name>
                </uniquevalue-generation>
            </column>
            <column name="user_id">
                <data-type>BIGINT</data-type>
                <nullable>false</nullable>
            </column>
            <column name="target_table">
                <data-type>CHAR</data-type>
                <max-size>100</max-size>
                <nullable>false</nullable>
            </column>
            <column name="target_id">
                <data-type>BIGINT</data-type>
                <nullable>false</nullable>
            </column>
            <column name="action">
                <data-type>CHAR</data-type>
                <max-size>50</max-size>
                <nullable>false</nullable>
            </column>
            <column name="old_data">
                <data-type>CHAR</data-type>
            </column>
            <column name="new_data">
                <data-type>CHAR</data-type>
            </column>
            <column name="ip_address">
                <data-type>CHAR</data-type>
                <max-size>100</max-size>
            </column>
            <column name="created_at">
                <data-type>BIGINT</data-type>
            </column>
        </columns>
        <primary-key name="audit_logs_pk">
            <primary-key-column>id</primary-key-column>
        </primary-key>
        <foreign-keys>
            <foreign-key name="fk_audit_user" reference-table-name="user">
                <fk-columns>
                    <fk-column>
                        <fk-local-column>user_id</fk-local-column>
                        <fk-reference-column>id</fk-reference-column>
                    </fk-column>
                </fk-columns>
            </foreign-key>
        </foreign-keys>
    </table>

    <table name="system_configs">
        <columns>
            <column name="id">
                <data-type>BIGINT</data-type>
                <nullable>false</nullable>
                <uniquevalue-generation>
                    <generator-name>system_configs.id</generator-name>
                </uniquevalue-generation>
            </column>
            <column name="config_key">
                <data-type>CHAR</data-type>
                <max-size>255</max-size>
                <nullable>false</nullable>
            </column>
            <column name="config_value">
                <data-type>CHAR</data-type>
            </column>
            <column name="config_type">
                <data-type>CHAR</data-type>
